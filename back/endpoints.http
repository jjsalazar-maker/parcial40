@baseUrl = http://localhost/parcial40/back/ms-auth/public

### =========================================
### MS-AUTH: USUARIOS Y SESIÓN
### =========================================

### Health check
GET {{baseUrl}}/
Accept: application/json

### 1. Crear usuario de prueba (público para registro inicial)
POST {{baseUrl}}/usuarios
Content-Type: application/json

{
  "nombre": "Juan Pérez",
  "correo": "juan@ejemplo.com",
  "usuario": "juanp",
  "contrasena": "Password123",
  "rol": "administrador",
  "estado": "activo"
}

### 2. Iniciar sesión con USUARIO (8.1.1)
POST {{baseUrl}}/login
Content-Type: application/json

{
  "usuario": "juanp",
  "contrasena": "Password123"
}

### 3. Iniciar sesión con CORREO (8.1.1)
POST {{baseUrl}}/login
Content-Type: application/json

{
  "correo": "juan@ejemplo.com",
  "contrasena": "Password123"
}

### 4. Iniciar sesión con credenciales incorrectas (8.1.1 -> 401)
POST {{baseUrl}}/login
Content-Type: application/json

{
  "usuario": "juanp",
  "contrasena": "incorrecta"
}

### 5. Validar sesión activa por GET (8.1.3)
@token = REEMPLAZAR_CON_TOKEN_DE_LOGIN
GET {{baseUrl}}/validar-sesion
Authorization: Bearer {{token}}
Accept: application/json

### 6. Validar sesión activa por POST con JSON (8.1.3)
POST {{baseUrl}}/validar-sesion
Content-Type: application/json

{
  "token": "{{token}}"
}

### 7. Ruta protegida CON token válido (200)
GET {{baseUrl}}/usuarios
Authorization: Bearer {{token}}
Accept: application/json

### 8. Ruta protegida SIN token (401)
GET {{baseUrl}}/usuarios
Accept: application/json

### 9. Cerrar sesión (8.1.2)
POST {{baseUrl}}/logout
Authorization: Bearer {{token}}
Accept: application/json

### 10. Validar sesión después de logout (debe fallar con 401)
GET {{baseUrl}}/validar-sesion
Authorization: Bearer {{token}}
Accept: application/json


### =========================================
### MS-CONDUCTORES
### =========================================
@conductoresUrl = http://localhost/parcial40/back/ms-conductores/public

### Health check ms-conductores
GET {{conductoresUrl}}/
Accept: application/json

### 11. Listar todos los conductores (requiere token)
GET {{conductoresUrl}}/conductores
Authorization: Bearer {{token}}
Accept: application/json

### 12. Crear conductor
POST {{conductoresUrl}}/conductores
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombres": "Carlos Alberto",
  "apellidos": "Gómez Ruiz",
  "documento": "1020304050",
  "telefono": "3001234567",
  "correo": "carlos.gomez@ejemplo.com",
  "numero_licencia": "LIC-998877",
  "categoria_licencia": "C2",
  "fecha_vencimiento_licencia": "2028-12-31"
}

### 13. Consultar conductor por documento
GET {{conductoresUrl}}/conductores/documento/1020304050
Authorization: Bearer {{token}}
Accept: application/json

### 14. Consultar conductor por licencia
GET {{conductoresUrl}}/conductores/licencia/LIC-998877
Authorization: Bearer {{token}}
Accept: application/json

### 15. Consultar conductores por estado (disponible, en_ruta, inactivo)
GET {{conductoresUrl}}/conductores/estado/disponible
Authorization: Bearer {{token}}
Accept: application/json

### 16. Editar conductor (información personal, licencia y/o estado)
PUT {{conductoresUrl}}/conductores/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "telefono": "3119998877",
  "categoria_licencia": "C3",
  "fecha_vencimiento_licencia": "2029-06-30"
}

### 17. Cambiar estado del conductor (disponible | en_ruta | inactivo)
PATCH {{conductoresUrl}}/conductores/1/estado
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "estado": "en_ruta"
}


### =========================================
### MS-VEHICULOS
### =========================================
@vehiculosUrl = http://localhost/parcial40/back/ms-vehiculos/public

### Health check ms-vehiculos
GET {{vehiculosUrl}}/
Accept: application/json

### 18. Listar todos los vehículos (requiere token)
GET {{vehiculosUrl}}/vehiculos
Authorization: Bearer {{token}}
Accept: application/json

### 19. Crear vehículo
POST {{vehiculosUrl}}/vehiculos
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "placa": "ABC123",
  "tipo_vehiculo": "Camión",
  "capacidad_carga": 5000,
  "modelo": "2024",
  "marca": "Chevrolet",
  "estado": "disponible"
}

### 20. Consultar vehículo por placa
GET {{vehiculosUrl}}/vehiculos/placa/ABC123
Authorization: Bearer {{token}}
Accept: application/json

### 21. Consultar vehículos por estado (disponible, en_ruta, mantenimiento, inactivo)
GET {{vehiculosUrl}}/vehiculos/estado/disponible
Authorization: Bearer {{token}}
Accept: application/json

### 22. Consultar vehículos por tipo
GET {{vehiculosUrl}}/vehiculos/tipo/Camión
Authorization: Bearer {{token}}
Accept: application/json

### 23. Editar vehículo (capacidad, estado e información general)
PUT {{vehiculosUrl}}/vehiculos/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "capacidad_carga": 6500,
  "estado": "mantenimiento",
  "modelo": "2025",
  "marca": "Chevrolet"
}

### 24. Cambiar estado del vehículo
PATCH {{vehiculosUrl}}/vehiculos/1/estado
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "estado": "en_ruta"
}
