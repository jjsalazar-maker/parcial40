@baseUrl = http://localhost/parcial40/back/ms-auth/public

### =========================================
### MS-AUTH: USUARIOS Y SESIÓN
### =========================================

### Health check
GET {{baseUrl}}/
Accept: application/json

### 1. Crear usuario de prueba (público para registro inicial)
POST {{baseUrl}}/usuarios
Content-Type: application/json

{
  "nombre": "Juan Pérez",
  "correo": "juan@ejemplo.com",
  "usuario": "juanp",
  "contrasena": "Password123",
  "rol": "administrador",
  "estado": "activo"
}

### 2. Iniciar sesión con USUARIO (8.1.1)
POST {{baseUrl}}/login
Content-Type: application/json

{
  "usuario": "juanp",
  "contrasena": "Password123"
}

### 3. Iniciar sesión con CORREO (8.1.1)
POST {{baseUrl}}/login
Content-Type: application/json

{
  "correo": "juan@ejemplo.com",
  "contrasena": "Password123"
}

### 4. Iniciar sesión con credenciales incorrectas (8.1.1 -> 401)
POST {{baseUrl}}/login
Content-Type: application/json

{
  "usuario": "juanp",
  "contrasena": "incorrecta"
}

### 5. Validar sesión activa por GET (8.1.3)
@token = REEMPLAZAR_CON_TOKEN_DE_LOGIN
GET {{baseUrl}}/validar-sesion
Authorization: Bearer {{token}}
Accept: application/json

### 6. Validar sesión activa por POST con JSON (8.1.3)
POST {{baseUrl}}/validar-sesion
Content-Type: application/json

{
  "token": "{{token}}"
}

### 7. Ruta protegida CON token válido (200)
GET {{baseUrl}}/usuarios
Authorization: Bearer {{token}}
Accept: application/json

### 8. Ruta protegida SIN token (401)
GET {{baseUrl}}/usuarios
Accept: application/json

### 9. Cerrar sesión (8.1.2)
POST {{baseUrl}}/logout
Authorization: Bearer {{token}}
Accept: application/json

### 10. Validar sesión después de logout (debe fallar con 401)
GET {{baseUrl}}/validar-sesion
Authorization: Bearer {{token}}
Accept: application/json
